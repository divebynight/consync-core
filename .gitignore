# OS / editor noise
.DS_Store
node_modules/
.vite/
out/

*.mp3
test-results/

# Generated sandbox artifacts
sandbox/current/*.json

# Generated runtime log
.scaffoldai/state/history/events.log

sandbox/probes/audio-session-capture/workdir/*

# ScaffoldAI bridge state (do not track)
.scaffoldai/state/next-action.md
.scaffoldai/state/snapshot.md
.scaffoldai/state/active-stream.md

# Optional: if you later add logs/history
.scaffoldai/state/history/
.scaffoldai/packets/

# ScaffoldAI runtime temp output (logs, debug artifacts, scratch)
# Keep the directory tracked via .gitkeep; ignore its contents
.scaffoldai/tmp/*
!.scaffoldai/tmp/.gitkeep
