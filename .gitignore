# OS / editor noise
.DS_Store
node_modules/
.vite/
out/

*.mp3
test-results/

# Generated sandbox artifacts
sandbox/current/*.json

# Consync product observational history (GUID creation events)
.consync/history/

sandbox/probes/audio-session-capture/workdir/*

# ScaffoldAI bridge state (do not track)
.scaffoldai/state/next-action.md
.scaffoldai/state/snapshot.md
.scaffoldai/state/active-stream.md

# Optional: if you later add logs/history
.scaffoldai/state/history/
.scaffoldai/packets/*
!.scaffoldai/packets/README.md

# ScaffoldAI runtime temp output (logs, debug artifacts, scratch)
# Keep the directory tracked via .gitkeep; ignore its contents
.scaffoldai/tmp/*
!.scaffoldai/tmp/.gitkeep
!.scaffoldai/tmp/README.md

# ScaffoldAI MCP runtime append artifacts
.scaffoldai/runtime/mcp/*
!.scaffoldai/runtime/mcp/README.md
!.scaffoldai/runtime/mcp/.gitkeep

# Prevent ScaffoldAI verify/debug logs from landing at repo root
.scaffoldai_verify.log
.scaffoldai_*.log
.vscode/

# Test/verification output artifacts
output.txt
verification_output.txt
verify-run-files.txt
